# .env do serviço de e-mail. No servidor, fica UM NÍVEL ACIMA do docroot (na home),
# fora da raiz web — não é servido. Não versione o .env real.

# Chave da Resend — só ESTE serviço tem (centralizado no ecossistema).
RESEND_API_KEY=re_sua_chave_real

# As chaves dos apps e a identidade de cada um vivem no apps.json (ao lado deste
# .env, acima do docroot). Veja apps.json.example.

# Remetente DEFAULT (usado quando um app não define `from` no apps.json).
# Precisa de domínio verificado na Resend.
MAIL_FROM=Nikolas Leme <formulario@nikolasleme.com.br>

# Destinatário FALLBACK legado. O normal é mandar `to` na requisição; isto só
# é usado quando o request não traz `to` válido. Pode deixar vazio pra exigir `to`.
MAIL_TO=contato@nikolasleme.com.br

# Rate limit padrão: requisições por minuto por app (janela fixa de 60s).
# 0 desativa. Cada app pode sobrescrever com "rpm" no apps.json.
RATE_LIMIT_PER_MIN=60
